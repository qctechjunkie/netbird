# NetBird Configuration (compose-level only)
# Copy this file to .env. NetBird-specific settings (domain, auth, IdP, DB DSN,
# secrets) live in config.yaml — see the README for details.
# Reference: https://docs.netbird.io/selfhosted/selfhosted-quickstart

# Volume Paths
# Base directory for NetBird data. Two subdirs are created:
#   ${DOCKER_DATA_PATH}/data     -> NetBird server data (/var/lib/netbird)
#   ${DOCKER_DATA_PATH}/postgres -> Postgres data (/var/lib/postgresql/data)
# Linux example:   /home/username/Docker/netbird
# Windows example: C:/Users/username/Docker/netbird
DOCKER_DATA_PATH=/path/to/your/netbird

# Timezone (find yours at https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/Chicago

# Image Tags
# NetBird combined server tag. Track the latest at
# https://hub.docker.com/r/netbirdio/netbird-server/tags
# Pin to a full version (e.g. "0.75.0") for zero-surprise updates.
NETBIRD_TAG=0.75.0

# Postgres tag. NetBird supports Postgres 12+. 17 is current stable (EOL Nov 2029).
POSTGRES_TAG=17

# Port Mappings (host:container)
# HTTP/gRPC bind + port for nginx-proxy-manager to hit.
#   - NPM on the SAME host: leave NETBIRD_HTTP_BIND=127.0.0.1
#   - NPM on a DIFFERENT host on the LAN: set NETBIRD_HTTP_BIND to this host's
#     LAN IP (e.g. 192.168.1.142). Do NOT set it to 0.0.0.0 unless you want
#     8081 exposed on every interface — the port carries plain HTTP.
# NPM proxies https://<your-netbird-domain> -> http://${NETBIRD_HTTP_BIND}:${NETBIRD_HTTP_PORT}.
NETBIRD_HTTP_BIND=127.0.0.1
NETBIRD_HTTP_PORT=8081
# STUN UDP port. MUST be reachable from the public internet (port-forwarded
# through the firewall). Cannot be proxied. Change only if 3478 is taken.
NETBIRD_STUN_PORT=3478
# Metrics endpoint (localhost only). Prometheus scrape target.
NETBIRD_METRICS_PORT=9090

# Database Configuration
# Must match the DSN password inside config.yaml (store/activityStore/authStore).
POSTGRES_DB=netbird
POSTGRES_USER=netbird
# Required. Change to a random password (e.g. `openssl rand -base64 32`).
POSTGRES_PASSWORD=changeme_secure_password

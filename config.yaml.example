# ==============================================================================
# NetBird Combined Server Configuration
# Reference: https://github.com/netbirdio/netbird/blob/main/combined/config.yaml.example
#
# Copy this file to config.yaml and edit the values marked "CHANGE ME".
# NetBird does NOT expand ${VAR} in this file — values are literal YAML.
#
# The Docker Compose stack overrides the store engine and encryption key via
# NETBIRD_STORE_CONFIG_ENGINE / NETBIRD_STORE_ENGINE_POSTGRES_DSN /
# NETBIRD_DATASTORE_ENC_KEY. You do NOT need to touch the `store` section
# below unless you're running netbird outside of that compose file.
# ==============================================================================

server:
  # Internal HTTP/gRPC listener inside the container. The compose file publishes
  # this on the host as NETBIRD_HTTP_PORT (default 8081). Reverse proxy forwards
  # https://<netbird domain> -> http://<host-ip>:8081.
  listenAddress: ":80"

  # Public URL peers connect to. Must match NETBIRD_PUBLIC_URL in .env.
  # CHANGE ME.
  exposedAddress: "https://netbird.example.com:443"

  # STUN listen ports (must match NETBIRD_STUN_PORT in .env).
  stunPorts:
    - 3478

  metricsPort: 9090
  healthcheckAddress: ":9000"

  logLevel: "info"
  logFile: "console"

  # CHANGE ME — random secret for relay auth between server and peers.
  # Generate: openssl rand -base64 32
  # This is NOT overridable via env var for the combined image; it must be
  # set here.
  authSecret: "REPLACE_WITH_openssl_rand_base64_32"

  dataDir: "/var/lib/netbird"

  # Embedded IdP (Dex). Log in with the owner account after first boot, then
  # add Authentik as a federated OIDC connector via the NetBird Dashboard UI:
  # Settings -> Identity Providers.
  auth:
    # CHANGE ME — public URL of your NetBird instance + /oauth2.
    issuer: "https://netbird.example.com/oauth2"
    signKeyRefreshEnabled: true
    # CHANGE ME — replace domain with yours (must match NETBIRD_DOMAIN).
    dashboardRedirectURIs:
      - "https://netbird.example.com/nb-auth"
      - "https://netbird.example.com/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"

  # Reverse proxy trust. Add the docker network CIDR that your nginx-proxy-
  # manager sits on so X-Forwarded-* headers are honored. NetBird uses these
  # to know the peer's real address.
  reverseProxy:
    trustedHTTPProxies:
      - "172.16.0.0/12"
      - "10.0.0.0/8"
      - "192.168.0.0/16"

  # Store — overridden by NETBIRD_STORE_* env vars in compose.yaml. Left as
  # sqlite here so the file parses if you ever run netbird stand-alone.
  store:
    engine: "sqlite"
    encryptionKey: ""

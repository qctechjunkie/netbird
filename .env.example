# ==============================================================================
# NetBird — Self-Hosted VPN
# Copy this file to .env and fill in your values.
# Reference: https://docs.netbird.io/selfhosted/selfhosted-quickstart
#
# Two files hold configuration:
#   .env         — compose-level knobs (this file): paths, ports, image tags,
#                  DB credentials, and any secret the netbird-server image
#                  can override via env var.
#   config.yaml  — NetBird server config: public URLs, OIDC issuer, redirect
#                  URIs, embedded IdP owner, reverseProxy trust. NetBird does
#                  NOT expand ${VAR} inside config.yaml, so values are literal.
#                  Copy from config.yaml.example.
# ==============================================================================

# ------------------------------------------------------------------------------
# Volume Paths
# Base directory for NetBird server data. One subdir is created:
#   ${DOCKER_DATA_PATH}/data -> /var/lib/netbird (server data, IdP DB, keys)
# Postgres data lives in the separate global-postgres stack.
# Linux example:   /home/username/Docker/netbird
# ------------------------------------------------------------------------------
DOCKER_DATA_PATH=/path/to/your/netbird

# ------------------------------------------------------------------------------
# Timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
# ------------------------------------------------------------------------------
TZ=America/New_York

# ------------------------------------------------------------------------------
# Image Tags
# Track the latest at https://hub.docker.com/r/netbirdio/netbird-server/tags
# Pin to a full version (e.g. "0.75.0") for zero-surprise updates.
# ------------------------------------------------------------------------------
NETBIRD_TAG=latest
NETBIRD_DASHBOARD_TAG=latest

# ------------------------------------------------------------------------------
# Domain / Public URL
# The URL peers and the dashboard use to reach the backend. Must match the
# `exposedAddress`, `auth.issuer`, and `dashboardRedirectURIs` values inside
# config.yaml. No trailing slash.
# ------------------------------------------------------------------------------
NETBIRD_DOMAIN=netbird.example.com
NETBIRD_PUBLIC_URL=https://netbird.example.com

# ------------------------------------------------------------------------------
# Port Mappings (host:container)
# Ports are bound on 0.0.0.0 — any interface can reach them. Put a reverse
# proxy (nginx-proxy-manager) in front for TLS termination.
# ------------------------------------------------------------------------------
# Dashboard SPA — nginx-proxy-manager forwards / (catch-all) here.
NETBIRD_DASHBOARD_PORT=8080
# Backend HTTP + gRPC — NPM forwards /api, /oauth2, /relay, /ws-proxy, and
# every /*.gRPC*/ path here.
NETBIRD_HTTP_PORT=8081
# STUN over UDP. MUST be publicly reachable (port-forward on your router).
# Cannot be proxied through NPM — UDP + STUN don't map to HTTP.
NETBIRD_STUN_PORT=3478

# ------------------------------------------------------------------------------
# Secrets
# ------------------------------------------------------------------------------
# 32-byte base64. Generate with: openssl rand -base64 32
# Encrypts data at rest (personal access tokens, setup keys, IdP secrets).
# Rotating this key requires a data-migration step — plan before changing.
NETBIRD_DATASTORE_ENC_KEY=REPLACE_WITH_openssl_rand_base64_32

# NOTE: `authSecret` (relay auth secret) also has to be set — it lives in
# config.yaml because the combined image does not expose an env-var override
# for it. Generate a separate value with `openssl rand -base64 32`.

# ------------------------------------------------------------------------------
# Database (shared global-postgres instance)
# Credentials must match the netbird block in the global-postgres .env.
# ------------------------------------------------------------------------------
NETBIRD_DB=netbird
NETBIRD_DB_USER=netbird_user
NETBIRD_DB_PASSWORD=changeme_secure_password
NETBIRD_DB_HOST=global-postgres
NETBIRD_DB_PORT=5432

# ------------------------------------------------------------------------------
# Networking — Global PostgreSQL
# Must match NETWORK_NAME in the global-postgres stack .env.
# ------------------------------------------------------------------------------
POSTGRES_NETWORK_NAME=global-postgres-network
